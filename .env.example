# Copy to .env and fill in. NEVER commit the real .env.
# Settings are prefixed with STB_ and nested with __ (double underscore).

# Trading mode: BACKTEST | PAPER | LIVE
STB_MODE=PAPER
STB_DRY_RUN=true

# Database (async SQLAlchemy URL). Default = local sqlite.
STB_DB_URL=sqlite+aiosqlite:///./data/short_trading_bot.db

# Logging: DEBUG | INFO | WARNING | ERROR ; FORMAT: console | json
STB_LOG_LEVEL=INFO
STB_LOG_FORMAT=console

# --- KIS Developers credentials (per environment) ---
# Paper (모의투자)
STB_KIS__PAPER__APP_KEY=
STB_KIS__PAPER__APP_SECRET=
STB_KIS__PAPER__ACCOUNT_NO=
STB_KIS__PAPER__ACCOUNT_PRODUCT_CODE=01

# Live (실전투자)
STB_KIS__LIVE__APP_KEY=
STB_KIS__LIVE__APP_SECRET=
STB_KIS__LIVE__ACCOUNT_NO=
STB_KIS__LIVE__ACCOUNT_PRODUCT_CODE=01

# Optional: DART OpenAPI key (news pipeline, P4)
STB_DART_API_KEY=

# Optional: alert channels (P5)
STB_NOTIFIER__TELEGRAM_BOT_TOKEN=
STB_NOTIFIER__TELEGRAM_CHAT_ID=
